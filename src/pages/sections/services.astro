---
const services = [
    { number: "01", icon: "✳", title: "Creative Design", description: "Visual identities and digital experiences shaped around your idea and audience." },
    { number: "02", icon: "↗", title: "Website Creation", description: "Responsive, polished websites that feel clear, memorable, and easy to use." },
    { number: "03", icon: "{ }", title: "System Development", description: "Purposeful digital tools that turn complex needs into simple, reliable flows." }
];
---

<section id="services" class="services section-wrap">
    <header class="services-heading reveal">
        <p class="section-kicker">HOW WE CAN HELP YOU</p>
        <h2 class="section-title">Made to move<br /><span class="accent-text">ideas forward.</span></h2>
    </header>
    <div class="service-grid">
        {services.map((service) => (
            <article class="service-card reveal">
                <span class="service-number">{service.number}</span>
                <span class="symbol" aria-hidden="true">{service.icon}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
            </article>
        ))}
    </div>
</section>

<style>
    .services { padding-block:clamp(85px,11vw,135px); }
    .services-heading { margin-bottom:40px; }
    .service-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .service-card { min-height:250px; padding:25px; border:1px solid var(--border); border-radius:5px; background:#121214; transition:.25s ease; }
    .service-card:hover { transform:translateY(-5px); border-color:rgb(255 59 48 / 55%); }
    .service-number { color:#77777e; font-size:10px; letter-spacing:.1em; }
    .symbol { display:block; margin:28px 0 18px; color:var(--accent); font-size:27px; font-weight:700; }
    .service-card h3 { margin:0 0 10px; font-size:17px; }
    .service-card p { margin:0; color:var(--muted); font-size:12px; line-height:1.7; }
    @media(max-width:760px){.service-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:540px){.service-grid{grid-template-columns:1fr}}
</style>
